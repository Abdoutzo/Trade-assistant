# Copy to .env and fill in. Real values go in .env (ignored by git), never in this file.

# --- Access ---------------------------------------------------------------------------------
# dev on your machine, prod once deployed (then APP_PASSWORD and SECRET_KEY are mandatory).
ENV=dev
# Empty in dev = no login page. Choose a long password before deploying.
APP_PASSWORD=
# Random string of 32+ characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

# --- Database -------------------------------------------------------------------------------
# Local SQLite by default. In production, the connection string of a free Neon database
# (https://neon.tech), pasted as given: postgresql://user:password@host/dbname?sslmode=require
# DATABASE_URL=sqlite:///data/trade_assistant.db

# --- AI models (free tiers) -----------------------------------------------------------------
# Only the keys you have are needed; the more you set, the more fallbacks the router has.
# NVIDIA NIM, the main one: https://build.nvidia.com (developer account, ~40 requests/min)
NVIDIA_API_KEY=
# Google Gemini, for long reports (1M tokens): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Groq, very fast, for news triage: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter, optional extra fallback: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Optional: change the models of a role ("provider:model" separated by commas, tried in order).
# LLM_CHAIN_REASONING=nvidia:nvidia/nemotron-3-ultra-550b-a55b,nvidia:z-ai/glm-5.3,google:gemini-flash-latest
# LLM_CHAIN_LONG_CONTEXT=google:gemini-flash-latest
# LLM_CHAIN_FAST=groq:openai/gpt-oss-120b

# --- Investment profile ---------------------------------------------------------------------
# Starting values only: once the site has run, change them in Réglages > Mon profil d'investissement.
INITIAL_AMOUNT_EUR=500
MONTHLY_AMOUNT_EUR=100
# Share of each payment going to the world ETF (the rest goes to the selected stocks).
CORE_SHARE=0.70
ACCOUNT_TYPE=PEA
